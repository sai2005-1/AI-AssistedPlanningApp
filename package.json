{
  "name": "figma-make-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "pnpm dev:emulator",
    "dev:emulator": "FIREBASE_MODE=emulator NEXT_PUBLIC_FIREBASE_MODE=emulator firebase emulators:exec --project demo-signal --only auth,firestore,storage \"next dev --hostname 0.0.0.0\"",
    "dev:cloud": "FIREBASE_MODE=cloud NEXT_PUBLIC_FIREBASE_MODE=cloud next dev --hostname 0.0.0.0",
    "build": "payload build",
    "start": "next start",
    "format": "oxfmt",
    "test": "vitest run",
    "test:firestore": "firebase emulators:exec --project demo-signal --only firestore \"vitest run src/lib/app-data.test.ts\"",
    "test:firebase": "firebase emulators:exec --project demo-signal --only auth,firestore \"vitest run src/lib/app-data.test.ts src/lib/firebase-auth.test.ts\"",
    "emulators": "firebase emulators:start --project demo-signal --only auth,firestore,storage",
    "seed:emulator": "tsx scripts/seed-firestore.ts",
    "generate:importmap": "payload generate:importmap",
    "generate:types": "payload generate:types",
    "payload": "payload",
    "lint": "eslint src scripts *.mjs *.ts --max-warnings 0",
    "test:isolation": "node scripts/check-test-isolation.mjs",
    "format:check": "oxfmt --check \"src/lib/**/*.{ts,tsx}\" \"src/app/(frontend)/*.{ts,tsx}\" vitest.config.ts eslint.config.mjs scripts/check-test-isolation.mjs"
  },
  "dependencies": {
    "@google/genai": "^3.3.0",
    "@payloadcms/figma": "1.0.0-beta.1",
    "@payloadcms/next": "4.0.0-beta.3",
    "@payloadcms/plugin-cloud-storage": "4.0.0-beta.3",
    "@payloadcms/plugin-mcp": "4.0.0-beta.3",
    "@payloadcms/richtext-lexical": "4.0.0-beta.3",
    "@payloadcms/translations": "4.0.0-beta.3",
    "@payloadcms/ui": "4.0.0-beta.3",
    "firebase": "^13.3.0",
    "firebase-admin": "^14.5.1",
    "graphql": "^16.8.1",
    "html-react-parser": "^5.2.10",
    "monaco-editor": "0.55.1",
    "next": "16.4.6",
    "payload": "4.0.0-beta.3",
    "react": "19.2.1",
    "react-dom": "19.2.1",
    "sharp": "^0.35.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^10.15.0",
    "firebase-tools": "^15.36.0",
    "globals": "^17.14.0",
    "oxfmt": "^0.78.0",
    "postcss": "^8.5.0",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=22.0.0",
    "pnpm": "^9 || ^10"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "sharp",
      "esbuild",
      "unrs-resolver"
    ]
  }
}

@startuml
title Issue #4 - Create and Assign a Team Deliverable
hide footbox
skinparam shadowing false

actor "Project owner" as Owner
boundary "Deliverable board" as UI
control "Server Action" as Action
control "Team data-access layer" as Store
control "App authentication" as Auth
database "Payload" as Payload
database "Cloud Firestore" as Firestore

Owner -> UI: Enter title, description, assignee,\nand target deadline
note over UI
  Creation path for an already loaded project.
  UI rejects invalid dates and deadlines after the freeze
  before submitting; server checks remain authoritative.
end note
UI -> Action: createProjectDeliverableAction(projectId, input)
Action -> Auth: requireAppUser()
opt app-session cookie exists
  Auth -> Payload: JWTAuthentication()
  Payload --> Auth: Authentication result (or throw)
end
Auth --> Action: AppUser, null, or throw

alt unauthenticated or authentication failure
  Action --> UI: Structured sign-in error or generic fallback
  UI --> Owner: Show error
else authenticated
  Action -> Action: Validate project ID; allowlist, validate,\nand normalize input

  alt invalid submitted fields
    Action --> UI: Structured input error; no repository call
    UI --> Owner: Show error
  else valid submitted fields
    Action -> Store: createProjectDeliverable(user, projectId, input)
    Store -> Store: getTeamFirestore() (may throw)
    opt Firestore configured
      group Firestore transaction (abort on a failed check)
        Store -> Firestore: Read project, requester membership,\nand assignee membership
        Firestore --> Store: Project and membership documents
        Store -> Store: Check project, requester membership, owner,\nassignee membership, then dueAt <= finalDeadline - 72h
        opt preceding checks pass and parent supplied
          Store -> Firestore: Read parent chain within this project
          Firestore --> Store: Parent documents
          Store -> Store: Reject missing parent, cycle, or depth > 50
        end
        opt all checks pass
          Store -> Firestore: Write deliverable in transaction\n(status=open, timestamps, assignee snapshot)
          Firestore --> Store: Commit succeeds (or throws)
        end
      end
    end

    alt validation, configuration, or database failure
      Store --> Action: Throw error
      Action --> UI: Structured domain/configuration error\nor generic failure for unexpected errors
      UI --> Owner: Show error
    else committed
      Store --> Action: { id }
      Action --> UI: Serializable success result
      UI -> Action: loadTeamProjectBoardAction(projectId)
      Action -> Auth: requireAppUser() again
      opt app-session cookie exists
        Auth -> Payload: JWTAuthentication()
        Payload --> Auth: Authentication result (or throw)
      end
      Auth --> Action: Current AppUser, null, or throw
      opt authenticated and valid project ID
        Action -> Store: loadTeamProjectBoard(user.id, projectId)
        Store -> Firestore: Read project and requester membership;\nif authorized, read members and deliverables
        Firestore --> Store: Documents (or error)
        Store --> Action: TeamProjectBoard (or throw)
      end
      Action --> UI: Serializable success or error result
      alt reload succeeded
        UI --> Owner: Display updated board in assignee lanes
      else reload failed
        UI --> Owner: Saved, but board could not be refreshed
      end
    end
  end
end
@enduml

@startuml
title Firebase Firestore Application Data Model
hide methods
left to right direction
skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam packageStyle rectangle

legend right
  Firebase Authentication owns credentials; passwords are never stored in Firestore.
  Every app-data write/read uses Firebase Admin repositories and an ownerId check.
  Firestore Rules deny direct browser access because Admin SDK calls bypass Rules.
endlegend

package "Firebase Authentication" {
  class AuthIdentity <<Firebase Auth>> {
    uid: string [provider key]
    email: string
    emailVerified: boolean
  }
}

package "Cloud Firestore" {
  abstract class OwnedDocument {
    ownerId: string
    createdAt: ISO string
    updatedAt: ISO string
  }

  class UserProfile <<users/{profileId}>> {
    authUid: string
    email: string
    name: string
    username: string
    role: admin | student | test
    createdAt: ISO string
    updatedAt: ISO string
  }

  class UsernameReservation <<usernames/{normalizedUsername}>> {
    profileId: string
  }

  class AuthProfileMap <<authUserProfiles/{firebaseUid}>> {
    profileId: string
  }

  class Course <<courses/{courseId}>> {
    code: string [unique per owner]
    name: string
    level: ClassLevel
    color: blue | green | gray
  }

  class Task <<tasks/{taskId}>> {
    title: string
    assignmentType: AssignmentType
    classLevel: ClassLevel
    courseId: string?
    calendarEventId: string?
    dueDate: ISO string?
    plannedStart: ISO string?
    estimatedMinutes: number
    careerAlignment: number?
    consequence: number?
    goalAlignment: number?
    lastWorkedAt: ISO string?
    status: open | scheduled | done
    score: number
    urgency: number
    academicValue: number
    careerValue: number
    goalAlignment: number
    consequence: number
    workload: number
    neglectFactor: number
  }

  class CalendarEvent <<calendarEvents/{eventId}>> {
    title: string
    start: ISO string
    end: ISO string
    allDay: boolean
    completed: boolean
    kind: class | lab | office | deadline | study | other
    location: string?
    description: string?
    uid: string
    source: ics-file | ics-url | manual
    sourceKey: string
    courseId: string?
  }

  class TeamProject <<teamProjects/{projectId}>> {
    title: string
    description: string
    finalDeadline: Timestamp
    ownerId: string
    createdAt: Timestamp
    updatedAt: Timestamp
  }

  class ProjectMember <<members/{encodedUserId}>> {
    userId: string
    name: string
    username: string
    role: owner | member
    createdAt: Timestamp
  }

  class Deliverable <<deliverables/{deliverableId}>> {
    projectId: string
    parentDeliverableId: string?
    assigneeId: string
    assigneeName: string
    assigneeUsername: string
    title: string
    description: string
    dueAt: Timestamp
    status: open | in-progress | done
    createdAt: Timestamp
    updatedAt: Timestamp
  }

  class TeamUserDirectory <<teamUserDirectory/{encodedUserId}>> {
    userId: string
    name: string
    username: string
    nameNormalized: string
    usernameNormalized: string
    updatedAt: Timestamp
  }

  class UserProjectIndex <<projects/{projectId}>> {
    projectId: string
    role: owner | member
    createdAt: Timestamp
  }
}

OwnedDocument <|-- Course
OwnedDocument <|-- Task
OwnedDocument <|-- CalendarEvent
AuthIdentity "1" -- "1" AuthProfileMap : uid mapping
AuthProfileMap "*" --> "1" UserProfile : profileId
UserProfile "1" -- "1" UsernameReservation : normalized username
Course "0..1" <-- "0..*" Task : courseId
CalendarEvent "0..1" <-- "0..*" Task : calendarEventId
Course "0..1" <-- "0..*" CalendarEvent : courseId
UserProfile "1" <-- "0..*" Course : ownerId
UserProfile "1" <-- "0..*" Task : ownerId
UserProfile "1" <-- "0..*" CalendarEvent : ownerId
UserProfile "1" <-- "0..*" TeamProject : ownerId
TeamProject "1" *-- "1..*" ProjectMember : members subcollection
TeamProject "1" *-- "0..*" Deliverable : deliverables subcollection
ProjectMember "1" <-- "0..*" Deliverable : assigneeId
Deliverable "0..1" <-- "0..*" Deliverable : parent / children
UserProfile "1" <-- "0..1" TeamUserDirectory : userId
TeamUserDirectory "1" *-- "0..*" UserProjectIndex : projects subcollection
TeamProject "1" <-- "0..*" UserProjectIndex : projectId

note right of Task
  Owner-scoped indexes:
  ownerId + score DESC
  ownerId + calendarEventId
  ownerId + courseId
end note

note right of CalendarEvent
  Owner-scoped indexes:
  ownerId + start
  ownerId + sourceKey
  ownerId + courseId
end note

note bottom of Course
  Index: ownerId + code.
  Document ID includes a deterministic
  hash of ownerId and normalized code.
end note

note bottom of Deliverable
  Server-enforced invariants:
  - assignee must be a project member
  - parent must be in the same project
  - dueAt <= finalDeadline - 72 hours
  Membership document ID is encoded userId.
end note

note bottom of AuthProfileMap
  Signup transaction creates profile,
  username reservation, and uid mapping.
  Session cookie contains no Firestore data.
end note
@enduml

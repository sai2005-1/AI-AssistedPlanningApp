FIREBASE_PROJECT_ID=your-development-project-id
FIREBASE_CLIENT_EMAIL=your-service-account-email
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nreplace-with-a-development-key\n-----END PRIVATE KEY-----\n"
FIREBASE_STORAGE_BUCKET=your-development-project.appspot.com

# Firebase Web App configuration (public values, not secrets)
NEXT_PUBLIC_FIREBASE_API_KEY=your-firebase-web-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-development-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-development-project-id
NEXT_PUBLIC_FIREBASE_APP_ID=your-firebase-web-app-id

# Local Emulator Suite only; leave unset when using a cloud development project.
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
# NEXT_PUBLIC_FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
# STORAGE_EMULATOR_HOST=127.0.0.1:9199

# Optional server-only Gemini Advisor configuration. Never use NEXT_PUBLIC_.
# Set the real key privately in .env.local or the Make environment-variable card.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

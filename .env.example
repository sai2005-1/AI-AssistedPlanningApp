FIREBASE_PROJECT_ID=your-development-project-id
FIREBASE_CLIENT_EMAIL=your-service-account-email
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nreplace-with-a-development-key\n-----END PRIVATE KEY-----\n"

# Optional server-only Gemini Advisor configuration. Never use NEXT_PUBLIC_.
# Set the real key privately in .env.local or the Make environment-variable card.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
